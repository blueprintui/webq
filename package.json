{
  "name": "webq-monorepo",
  "packageManager": "bun@1.3.10",
  "type": "module",
  "workspaces": [
    "projects/*"
  ],
  "scripts": {
    "ci": "wireit",
    "ci:nocache": "bun run clean && bun i --frozen-lockfile && bun run ci",
    "format": "wireit",
    "format:fix": "wireit",
    "release": "wireit",
    "clean": "git clean -dfX",
    "prepare": "husky"
  },
  "wireit": {
    "ci": {
      "dependencies": [
        "format",
        "./projects/cli:ci"
      ]
    },
    "format": {
      "command": "prettier --config=prettier.config.js --check --cache .",
      "files": [
        "projects/**/*.ts",
        "projects/**/*.json",
        "projects/**/*.md",
        "!**/.wireit/**",
        "!**/dist/**"
      ],
      "output": [
        "node_modules/.cache/prettier/**"
      ]
    },
    "format:fix": {
      "command": "prettier --config=prettier.config.js --write ."
    },
    "release": {
      "command": "echo 'Releasing...'",
      "dependencies": [
        "release:cli"
      ]
    },
    "release:cli": {
      "command": "cd projects/cli && HUSKY=0 bun x semantic-release"
    },
    "release:eslint": {
      "command": "cd projects/eslint && HUSKY=0 bun x semantic-release",
      "dependencies": [
        "release:cli"
      ]
    }
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.6",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.0",
    "conventional-changelog-conventionalcommits": "^9.3.0",
    "husky": "9.1.7",
    "prettier": "3.8.1",
    "semantic-release": "25.0.3",
    "wireit": "0.14.12"
  }
}
